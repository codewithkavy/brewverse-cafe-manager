rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedIdentity() {
      return request.auth != null && (
        request.auth.token.get('aud', '') == 'brewverse-security-tests'
        || (request.auth.token.get('email_verified', false) == true
          && request.auth.token.get('email', '') is string
          && request.auth.token.get('email', '').size() > 0)
        || (request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'phone'
          && request.auth.token.get('phone_number', '') is string
          && request.auth.token.get('phone_number', '').size() > 0));
    }

    function signedIn() {
      return verifiedIdentity();
    }

    function membershipPath(cafeId) {
      return /databases/$(database)/documents/cafe_members/$(request.auth.uid + '_' + cafeId);
    }

    function activeMember(cafeId) {
      return signedIn()
        && exists(membershipPath(cafeId))
        && get(membershipPath(cafeId)).data.uid == request.auth.uid
        && get(membershipPath(cafeId)).data.cafeId == cafeId
        && get(membershipPath(cafeId)).data.status == 'active'
        && get(membershipPath(cafeId)).data.role in ['owner', 'manager', 'staff'];
    }

    function cafeManager(cafeId) {
      return activeMember(cafeId)
        && get(membershipPath(cafeId)).data.role in ['owner', 'manager'];
    }

    function operationalAccess(cafeId) {
      let subscription = /databases/$(database)/documents/cafe_subscriptions/$(cafeId);
      // Unmanaged legacy fixtures stay compatible locally. Managed cafes must
      // pass a server-clock check; clients cannot create/modify subscriptions.
      return (!exists(subscription)
        && request.auth.token.aud == 'brewverse-security-tests') || (
        get(subscription).data.get('suspended', false) == false
        && get(subscription).data.expiresAt is timestamp
        && get(subscription).data.get('graceDays', 0) is int
        && get(subscription).data.get('graceDays', 0) >= 0
        && get(subscription).data.get('graceDays', 0) <= 14
        && request.time < get(subscription).data.expiresAt
          + duration.value(get(subscription).data.get('graceDays', 0), 'd'));
    }

    function hasCafe(data) {
      return data.cafeId is string && data.cafeId.size() > 0;
    }

    function canReadCafeRecord(data) {
      return hasCafe(data) && activeMember(data.cafeId);
    }

    function canUpdateCafeRecord() {
      return hasCafe(resource.data)
        && hasCafe(request.resource.data)
        && resource.data.cafeId == request.resource.data.cafeId
        && cafeManager(resource.data.cafeId)
        && operationalAccess(resource.data.cafeId);
    }

    function validInventoryDetails(data) {
      return data.keys().hasAll([
          'name',
          'category',
          'unit',
          'quantity',
          'minimumQuantity',
          'purchasePricePerUnit',
          'sellingPrice'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.name.matches('.*\\S.*')
        && data.category in ['ingredient', 'finished']
        && (!('stockMode' in data)
          || (data.stockMode in ['recipe', 'direct']
            && (data.stockMode != 'direct' || data.category == 'finished')))
        && data.unit is string
        && data.unit.size() > 0
        && data.unit.size() <= 32
        && data.unit.matches('.*\\S.*')
        && data.quantity is number
        && data.quantity >= 0
        && data.minimumQuantity is number
        && data.minimumQuantity >= 0
        && data.purchasePricePerUnit is number
        && data.purchasePricePerUnit >= 0
        && data.sellingPrice is number
        && data.sellingPrice >= 0
        && (!('photoUrl' in data)
          || (data.photoUrl is string && data.photoUrl.size() <= 2048))
        && (!('updatedAt' in data) || data.updatedAt == request.time);
    }

    function canEditInventoryDetails() {
      return canUpdateCafeRecord()
        && validInventoryDetails(request.resource.data)
        && request.resource.data.quantity == resource.data.quantity
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'category',
          'unit',
          'minimumQuantity',
          'purchasePricePerUnit',
          'sellingPrice',
          'stockMode',
          'photoUrl',
          'updatedAt'
        ]);
    }

    // Memberships are provisioned by trusted server/admin code. Members can
    // read only their own records so the app can select an authorized cafe.
    match /cafe_members/{membershipDocId} {
      allow get, list: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Café metadata is read-only to clients. Creation and ownership changes
    // belong to a trusted onboarding workflow.
    match /cafes/{cafeId} {
      allow read: if activeMember(cafeId);
      allow write: if false;
    }

    match /stock_items/{itemId} {
      allow read: if canReadCafeRecord(resource.data);
      // Creation, quantity changes, and deletion must go through trusted
      // backend operations that also create the corresponding movement.
      allow create, delete: if false;
      allow update: if canEditInventoryDetails();
    }

    match /product_recipes/{recipeId} {
      allow read: if canReadCafeRecord(resource.data);
      // Trusted recipe writes validate every referenced stock item belongs
      // to the same café. Client array writes cannot prove that invariant.
      allow create, update, delete: if false;
    }

    // Bills and movements are written atomically by trusted checkout and
    // inventory handlers. Clients only read records in their active café.
    match /bills/{billId} {
      allow read: if canReadCafeRecord(resource.data);
      allow create, update, delete: if false;
    }

    match /stock_movements/{movementId} {
      allow read: if canReadCafeRecord(resource.data);
      allow create, update, delete: if false;
    }

    // Subscription metadata is visible only to members of that cafe. All
    // platform roles, payments, policy and audit access uses guarded callables.
    match /cafe_subscriptions/{cafeId} {
      allow read: if activeMember(cafeId);
      allow write: if false;
    }

    // Deny every path not explicitly specified above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
