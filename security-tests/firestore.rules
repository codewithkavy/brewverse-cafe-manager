rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function membershipId(cafeId) {
      return request.auth.uid + '_' + cafeId;
    }

    function activeMember(cafeId) {
      return signedIn()
        && exists(/databases/$(database)/documents/cafe_members/$(membershipId(cafeId)))
        && get(/databases/$(database)/documents/cafe_members/$(membershipId(cafeId))).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/cafe_members/$(membershipId(cafeId))).data.cafeId == cafeId
        && get(/databases/$(database)/documents/cafe_members/$(membershipId(cafeId))).data.status == 'active';
    }

    // Membership records are provisioned by trusted server/admin code only.
    match /cafe_members/{membershipDocId} {
      allow read, write: if false;
    }

    // Initial test scope only: inventory isolation.
    // Expand to recipes, bills, movements, cafes, and Storage only after
    // the model and role matrix are finalized. This file is test-only.
    match /stock_items/{itemId} {
      allow read: if resource.data.cafeId is string
        && activeMember(resource.data.cafeId);

      allow create: if request.resource.data.cafeId is string
        && activeMember(request.resource.data.cafeId);

      allow update: if resource.data.cafeId is string
        && request.resource.data.cafeId == resource.data.cafeId
        && activeMember(resource.data.cafeId);

      allow delete: if resource.data.cafeId is string
        && activeMember(resource.data.cafeId);
    }

    // Deny all other paths until explicitly specified and tested.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
